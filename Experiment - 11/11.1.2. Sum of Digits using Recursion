def sum_of_digits_recursive(n):
    # Base case: if n is a single digit, return n
    if n < 10:
        return n
    
    # Recursive step: last digit + sum of remaining digits
    return (n % 10) + sum_of_digits_recursive(n // 10)

# Example usage (as seen in the image)
number = int(input()) # Or any non-negative integer
result = sum_of_digits_recursive(number)
